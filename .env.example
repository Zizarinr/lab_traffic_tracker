# ============================================================
# Lab Scan KTM — contoh konfigurasi.
# Salin file ini menjadi `.env`, lalu sesuaikan. Server membaca
# `.env` hanya saat mulai: ubah nilai -> restart server/PC.
# ============================================================

# --- Server & identitas lab ---
# Port lokal (hanya 127.0.0.1). Ganti bila 3000 bentrok.
PORT=3000
# Nama lab yang tampil di layar standby.
LAB_NAME=LAB-1

# --- Perilaku scan ---
# Input scanner & ketik manual aktif otomatis; tidak ada setelan mode.
# Jeda minimum (detik) agar NIM yang sama tidak dicatat dua kali.
DEBOUNCE_SECONDS=10
# Lama layar sambutan (detik). Default kode: 3.
WELCOME_SECONDS=2

# --- Sinkronisasi ke sistem monitoring (Fase 2) ---
# `npm run mock` menjalankan server monitoring tiruan (port 4000).
# Saat false: layar standby menampilkan pengingat + jumlah log menunggu.
SYNC_ENABLED=false
# Interval pengiriman log (detik). Produksi: 300 (5 menit); uji: 10-60.
SYNC_INTERVAL_SECONDS=300
# Jumlah log maksimum per batch.
SYNC_BATCH_SIZE=100
# Batas waktu satu request kirim (detik).
SYNC_TIMEOUT_SECONDS=10
# Endpoint sistem monitoring. Kosongkan selama SYNC_ENABLED=false.
MONITOR_URL=http://192.168.1.50:8080/api/lab/traffic
# Token Bearer dari pengelola monitoring. Jangan di-commit.
MONITOR_TOKEN=
