PORT=3000
LAB_NAME=LAB-1
DEBOUNCE_SECONDS=10
WELCOME_SECONDS=2
# Sinkronisasi (Fase 2). `npm run mock` menjalankan server monitoring tiruan.
# Saat false: layar standby menampilkan PENGINGAT sinkronisasi nonaktif + jumlah log menunggu.
SYNC_ENABLED=false
# Interval pengiriman log ke monitoring. Produksi: 300 (5 menit, sesuai docs/api.md).
SYNC_INTERVAL_SECONDS=300
SYNC_BATCH_SIZE=100
SYNC_TIMEOUT_SECONDS=10
MONITOR_URL=http://192.168.x.x:PORT/api/lab/traffic
MONITOR_TOKEN=
